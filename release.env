# ── QVault 5 Mobile — configuration ──────────────────────────────
APP_NAME="QVault"
APP_SLUG="qvault"
APPLICATION_ID="com.qvault.app"
ANDROID_APP_DIR="android_app"
GRADLE_MODULE="app"

MIN_SDK=26
TARGET_SDK=35
COMPILE_SDK=35
BUILD_TOOLS_VERSION="35.0.0"

